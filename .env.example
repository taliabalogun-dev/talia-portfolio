# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth secret - generate with `openssl rand -base64 32`
AUTH_SECRET=

# Gmail address allowed to sign in to /admin/analytics (defaults to talia.balogun@gmail.com if unset)
ADMIN_EMAIL=talia.balogun@gmail.com

# Upstash Redis (upstash.com -> create a Redis database -> REST API section)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
